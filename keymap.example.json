[
  {
    "context": "Zetta > Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-shift-t": "zetta::NewTab",
      "ctrl-shift-n": "zetta::NewWindow",
      "ctrl-shift-w": "zetta::CloseTab",
      "ctrl-shift-q": "zetta::CloseWindow",
      "ctrl-shift-x": "zetta::CloseAllWindows",
      "ctrl-shift-d": "zetta::DetachTab",
      "ctrl-shift-k": "zetta::ToggleTabSharing",
      "ctrl-shift-a": "zetta::ReconnectSession",
      "ctrl-shift-b": "zetta::ToggleAutoBackgroundTab",
      "alt-shift-x": "zetta::ClosePane",
      "alt-shift-n": "zetta::ToggleStackedCommand",
      "alt-{": "zetta::SelectPreviousStackedPane",
      "alt-}": "zetta::SelectNextStackedPane",
      "alt-shift-[": "zetta::SelectPreviousStackedPane",
      "alt-shift-]": "zetta::SelectNextStackedPane",
      "ctrl-shift-o": "zetta::SplitHorizontalDown",
      "ctrl-shift-e": "zetta::SplitVerticalRight",
      "alt-shift-l": "zetta::RotatePaneLayout",
      "alt-shift-k": "zetta::RotatePaneLayoutCounterClockwise",
      "ctrl-shift-j": "zetta::TogglePaneResizeMode",
      "alt-shift-m": "zetta::TogglePaneMoveMode",
      "ctrl-shift-g": "zetta::ToggleTabMoveMode",
      "alt-shift-a": "terminal_view::SelectAll",
      "ctrl-shift-backspace": "terminal_view::ClearClipboard",
      "shift-escape": "zetta::ToggleMaximizePane",
      "ctrl-shift-i": "zetta::ToggleBroadcastInput",
      "ctrl-shift-s": "zetta::ToggleSilentMode",
      "ctrl-shift-m": "zetta::ToggleMultiCommand",
      "ctrl-tab": "zetta::NextTab",
      "ctrl-shift-tab": "zetta::PreviousTab",
      "ctrl-pageup": "zetta::NextTab",
      "ctrl-pagedown": "zetta::PreviousTab",
      "ctrl-alt-left": "zetta::PreviousTab",
      "ctrl-alt-right": "zetta::NextTab",
      "ctrl-cmd-left": "zetta::PreviousTab",
      "ctrl-cmd-right": "zetta::NextTab",
      "ctrl-shift-l": "terminal::Clear",
      "ctrl-v": "terminal::Paste",
      "shift-insert": "terminal::Paste",
      "cmd-l": "terminal::Clear",
      "cmd-v": "terminal::Paste",
      "alt-shift-f": "terminal_view::SearchScrollback",
      "alt-shift-v": "terminal_view::EditScrollback",
      "ctrl-shift-f": "zetta::SearchTabScrollback",
      "ctrl-alt-v": "terminal::PasteTrimmed",
      "ctrl-cmd-v": "terminal::PasteTrimmed",
      "alt-shift-s": "zetta::SavePaneOutput",
      "ctrl-shift-p": "zetta::ToggleCommandPalette",
      "ctrl-,": "zetta::ToggleSettings",
      "ctrl-shift-r": "zetta::RenameTab",
      "ctrl-shift-y": "zetta::ChangeTabIcon",
      "alt-shift-t": "zetta::ChangePaneTheme",
      "alt-shift-r": "zetta::RenamePane",
      "ctrl-=": "zetta::IncreaseTerminalFontSize",
      "ctrl-+": "zetta::IncreaseTerminalFontSize",
      "ctrl--": "zetta::DecreaseTerminalFontSize",
      "ctrl-0": "zetta::ResetTerminalFontSize",
      "ctrl-alt-r": "zetta::ReloadConfiguration",
      "ctrl-shift-f12": "zetta::TogglePerformanceOverlay",
      "alt-left": "zetta::FocusPaneLeft",
      "alt-right": "zetta::FocusPaneRight",
      "alt-up": "zetta::FocusPaneUp",
      "alt-down": "zetta::FocusPaneDown",
      "alt-shift-down": "zetta::MinimizePane",
      "alt-shift-up": "zetta::RestoreMinimizedPane",
      "alt-shift-left": "zetta::SelectPreviousMinimizedPane",
      "alt-shift-right": "zetta::SelectNextMinimizedPane",
      "alt-shift-o": ["zetta::ApplyPaneSplitTemplate", { "name": "three-right" }],
      "alt-shift-e": ["zetta::ApplyPaneSplitTemplate", { "name": "quarters" }],
      "alt-shift-=": "zetta::IncreasePaneFontSize",
      "alt-shift-+": "zetta::IncreasePaneFontSize",
      "alt-shift--": "zetta::DecreasePaneFontSize",
      "alt-shift-0": "zetta::ResetPaneFontSize",
      "Ctrl+Shift+1": ["zetta::OpenProfile", { "slot": 1 }],
      "Ctrl+Shift+2": ["zetta::OpenProfile", { "slot": 2 }],
      "Ctrl+Shift+3": ["zetta::OpenProfile", { "slot": 3 }],
      "Ctrl+Shift+4": ["zetta::OpenProfile", { "slot": 4 }],
      "Ctrl+Shift+5": ["zetta::OpenProfile", { "slot": 5 }],
      "Ctrl+Shift+6": ["zetta::OpenProfile", { "slot": 6 }],
      "Ctrl+Shift+7": ["zetta::OpenProfile", { "slot": 7 }],
      "Ctrl+Shift+8": ["zetta::OpenProfile", { "slot": 8 }],
      "Ctrl+Shift+9": ["zetta::OpenProfile", { "slot": 9 }],
      "Ctrl+Shift+0": ["zetta::OpenProfile", { "slot": 10 }]
    }
  },
  {
    "context": "Zetta",
    "bindings": {
      "alt-space": "zetta::OpenApplicationMenu",
      "ctrl-shift-h": "zetta::HideWindow"
    }
  },
  {
    "context": "",
    "bindings": {
      "cmd-t": "zetta::NewTab",
      "cmd-n": "zetta::NewWindow",
      "cmd-,": "zetta::ToggleSettings",
      "cmd-w": "zetta::CloseTab",
      "cmd-q": "zetta::CloseWindow",
      "cmd-x": "zetta::CloseAllWindows",
      "cmd-h": "zetta::HideWindow",
      "cmd-shift-h": "zetta::HideWindow",
      "ctrl-shift-h": "zetta::MinimizeWindow"
    }
  },
  {
    "context": "Zetta > PaneResize > Terminal",
    "bindings": {
      "left": "zetta::ResizePaneLeft",
      "right": "zetta::ResizePaneRight",
      "up": "zetta::ResizePaneUp",
      "down": "zetta::ResizePaneDown"
    }
  },
  {
    "context": "Zetta > PaneMove > Terminal",
    "bindings": {
      "left": "zetta::MovePaneLeft",
      "right": "zetta::MovePaneRight",
      "up": "zetta::MovePaneUp",
      "down": "zetta::MovePaneDown"
    }
  },
  {
    "context": "Zetta > TabMove > Terminal",
    "bindings": {
      "left": "zetta::MoveTabLeft",
      "right": "zetta::MoveTabRight"
    }
  },
  {
    "context": "Zetta > Terminal && selection",
    "bindings": {
      "ctrl-c": "terminal_view::CopyAndClearSelection",
      "ctrl-insert": "terminal_view::CopyAndClearSelection",
      "cmd-c": "terminal_view::CopyAndClearSelection"
    }
  },
  {
    "context": "Zetta > Terminal && scrollback_search",
    "bindings": {
      "enter": "terminal_view::SearchNextMatch",
      "shift-enter": "terminal_view::SearchPreviousMatch",
      "f3": "terminal_view::SearchNextMatch",
      "shift-f3": "terminal_view::SearchPreviousMatch",
      "escape": "terminal_view::DismissSearch",
      "ctrl-a": "terminal_view::SelectAllSearchText"
    }
  },
  {
    "context": "Zetta > menu",
    "bindings": {
      "left": "zetta::ActivateApplicationMenuLeft",
      "right": "zetta::ActivateApplicationMenuRight",
      "ctrl-tab": "zetta::NextTab",
      "ctrl-shift-tab": "zetta::PreviousTab",
      "ctrl-pageup": "zetta::NextTab",
      "ctrl-pagedown": "zetta::PreviousTab",
      "ctrl-alt-left": "zetta::PreviousTab",
      "ctrl-alt-right": "zetta::NextTab",
      "ctrl-cmd-left": "zetta::PreviousTab",
      "ctrl-cmd-right": "zetta::NextTab"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-w": "zetta::CloseTab"
    }
  }
]
