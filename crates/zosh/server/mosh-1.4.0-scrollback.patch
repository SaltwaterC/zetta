--- a/src/terminal/terminaldisplay.cc
+++ b/src/terminal/terminaldisplay.cc
@@ -64,6 +64,14 @@ std::string Display::new_frame( bool initialized, const Framebuffer &last, const
 
   char tmp[ 64 ];
 
+  /* Zosh extension: send an absolute generation, so retransmission and
+     diffs against an older acknowledged frame cannot repeat a clear. */
+  if ( f.get_scrollback_clear_count() != last.get_scrollback_clear_count() ) {
+    snprintf( tmp, sizeof tmp, "\033]777;zosh-clear-scrollback;%llu\007",
+              static_cast<unsigned long long>( f.get_scrollback_clear_count() ) );
+    frame.append( tmp );
+  }
+
   /* has bell been rung? */
   if ( f.get_bell_count() != frame.last_frame.get_bell_count() ) {
     frame.append( '\007' );
