{
  "default_profile": "System",
  "new_tab_profile": "default",
  "working_directory": "~",
  "working_directory_scope": "tab",
  "theme": "One Dark",
  "default_tab_icon": "terminal",
  "terminal_font_size": 14,
  "terminal_font_family": "MesloLGS NF",
  "max_scroll_history_lines": 2147483647,
  "inactive_pane_opacity": 0.8,
  "compact_mode": false,
  "hide_pane_size": true,
  "hide_title_bar_labels": false,
  "hide_title_bar_buttons": false,
  "hide_title_bar_menus": true,
  "pane_controls_position": "right",
  "pane_controls_hidden_by_default": false,
  "http_server_port": 8000,
  "tftp_server_port": 69,
  "pane_split_templates": {
    "three-bottom": {
      "env": { "PROJECT": "zetta" },
      "layout": {
        "horizontal": [
          { "label": "top" },
          { "vertical": [{ "label": "bottom-left" }, { "label": "bottom-right" }] }
        ]
      }
    }
  },
  "profiles": [
    { "name": "System", "theme": "One Light" },
    { "name": "Login Zsh", "program": "/bin/zsh", "args": ["-l"], "icon": "zsh" }
  ]
}
