{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/request-user-input-hook.sh \"Claude input required\"",
            "statusMessage": "Notifying Zetta about pending Claude input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/agent-stop-hook.sh",
            "timeout": 600,
            "statusMessage": "Linting, testing, and building Zetta"
          }
        ]
      }
    ]
  }
}
