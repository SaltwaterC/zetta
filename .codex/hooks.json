{
  "description": "Build Zetta after each completed Codex turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'make test >&2 && make build >&2 && printf \"%s\\n\" \"{\\\"continue\\\":true}\"'",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (& git rev-parse --show-toplevel) 'scripts/codex-stop-hook.ps1')\"",
            "statusMessage": "Testing and building Zetta"
          }
        ]
      }
    ]
  }
}
