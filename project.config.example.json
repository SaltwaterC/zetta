{
  "theme": "One Light",
  "dark_theme": "One Dark",
  "working_directory": ".",
  "default_profile": "System",
  "default_tab_icon": "terminal",
  "inactive_pane_opacity": 0.8,
  "env": {
    "PROJECT_ENV": "development"
  },
  "initial_split": "development",
  "pane_split_templates": {
    "development": {
      "env": {
        "PROJECT_ROLE": "development"
      },
      "layout": {
        "vertical": [
          { "label": "editor" },
          {
            "label": "server",
            "stack": [
              { "program": "cargo", "args": ["watch", "-x", "test"] }
            ]
          }
        ]
      }
    }
  },
  "profiles": [
    { "name": "System", "theme": "One Light", "dark_theme": "One Dark" }
  ]
}
